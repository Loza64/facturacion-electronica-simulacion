# Servidor
SERVER_PORT=3000

# Nombre de la aplicación
SPRING_APPLICATION_NAME=app

# Base de datos (PostgreSQL) local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/spring-app
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=12345678
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA / Hibernate
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (clave Base64 de 512 bits generada aleatoriamente; regenerar en cada entorno real)
SECURITY_JWT_SECRET_KEY=MI_CLAVE_ULTRA_SECRETA_PELELE
SECURITY_JWT_EXPIRATION_TIME=86400000

# SUPER_ADMIN (usado por SuperAdminSeeder)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@tudominio.com
SUPER_ADMIN_PASSWORD=<contraseña_fuerte_temporal>